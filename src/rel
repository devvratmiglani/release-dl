#!/usr/bin/pwsh
# GitHub Release Downloader
# Fully[Math]: terminal based PowerShell script
# Search GitHub repos, select a repo, select a release, then download release assets/source zip/tar.gz
# Downloads go to: ~/GitHubReleaseDownloads

$ErrorActionPreference = "Stop"

$DownloadRoot = Join-Path $HOME "GitHubReleaseDownloads"
New-Item -ItemType Directory -Force -Path $DownloadRoot | Out-Null

function Get-GitHubHeaders {
    $headers = @{
        "User-Agent" = "PowerShell-GitHub-Release-Downloader"
        "Accept"     = "application/vnd.github+json"
    }

    if ($env:GITHUB_TOKEN -and $env:GITHUB_TOKEN.Trim().Length -gt 0) {
        $headers["Authorization"] = "Bearer $env:GITHUB_TOKEN"
    }

    return $headers
}

function Get-ShortDescription {
    param(
        [string]$Text,
        [int]$MaxLines = 3,
        [int]$MaxCharsPerLine = 80
    )

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return "[No Description]"
    }

    $Text = $Text -replace '\r?\n', ' '

    $maxLength = $MaxLines * $MaxCharsPerLine

    if ($Text.Length -gt $maxLength) {
        $Text = $Text.Substring(0, $maxLength - 3) + "..."
    }

    return $Text
}

function ConvertTo-SafeFileName {
    param(
        [Parameter(Mandatory)]
        [string]$Name
    )

    $invalidChars = [System.IO.Path]::GetInvalidFileNameChars()
    foreach ($char in $invalidChars) {
        $Name = $Name.Replace($char, "_")
    }

    return $Name
}

function Read-SearchableMenu {
    param(
        [Parameter(Mandatory)]
        [array]$Items,

        [Parameter(Mandatory)]
        [string]$Title,

        [Parameter(Mandatory)]
        [scriptblock]$DisplayText,

        [int]$PageSize = 12
    )

    if (-not $Items -or $Items.Count -eq 0) {
        Write-Host "No items found." -ForegroundColor Yellow
        return $null
    }

    $filter = ""
    $selected = 0
    $selectedItems = New-Object System.Collections.Generic.HashSet[string]

    while ($true) {
        $filteredItems = @(
            $Items | Where-Object {
                (& $DisplayText $_) -like "*$filter*"
            }
        )

        if ($filteredItems.Count -eq 0) {
            $selected = 0
        }
        elseif ($selected -ge $filteredItems.Count) {
            $selected = $filteredItems.Count - 1
        }

        Clear-Host
        Write-Host $Title -ForegroundColor Cyan
        Write-Host ""
        Write-Host "Type to filter. Use Up/Down arrows. Enter to select. Esc to cancel."
        Write-Host "Search: $filter" -ForegroundColor Green
        Write-Host ""

        if ($filteredItems.Count -eq 0) {
            Write-Host "No matching results." -ForegroundColor Yellow
        }
        else {
            $start = [Math]::Max(0, $selected - [Math]::Floor($PageSize / 2))
            $end = [Math]::Min($filteredItems.Count - 1, $start + $PageSize - 1)

            if (($end - $start + 1) -lt $PageSize) {
                $start = [Math]::Max(0, $end - $PageSize + 1)
            }

            for ($i = $start; $i -le $end; $i++) {
                $item = $filteredItems[$i]
                $text = & $DisplayText $item

                $isChecked = $selectedItems.Contains($item.DownloadUrl)

                $prefix = if ($isChecked) { "[x]" } else { "[ ]" }


                $current = ($i -eq $selected)
                $checked = $selectedItems.Contains($item.DownloadUrl)

                if ($current -and $checked) {
                    Write-Host "> [x] $text" -ForegroundColor Black -BackgroundColor Green
                }
                elseif ($current) {
                    Write-Host "> [ ] $text" -ForegroundColor Black -BackgroundColor Gray
                }
                elseif ($checked) {
                    Write-Host "  [x] $text" -ForegroundColor White -BackgroundColor DarkGreen
                }
                else {
                    Write-Host "  [ ] $text"
                }
            }

            Write-Host ""
            Write-Host "Showing $($start + 1)-$($end + 1) of $($filteredItems.Count)"
        }

        $key = [System.Console]::ReadKey($true)

        switch ($key.Key) {
            "UpArrow" {
                if ($selected -gt 0) {
                    $selected--
                }
            }

            "DownArrow" {
                if ($filteredItems.Count -gt 0 -and $selected -lt ($filteredItems.Count - 1)) {
                    $selected++
                }
            }

            "Enter" {

                if ($selectedItems.Count -gt 0) {

                    return @(
                        $Items | Where-Object {
                            $selectedItems.Contains($_.DownloadUrl)
                        }
                    )
                }

                return @($filteredItems[$selected])
            }
            "O"{
                if ($filteredItems.Count -gt 0) {
                    $item = $filteredItems[$selected]
                    # Repository URL
                    if ($item.html_url) {
                        Start-Process $item.html_url
                    }
                }
            }

            "Escape" {
                return $null
            }

            "Backspace" {
                if ($filter.Length -gt 0) {
                    $filter = $filter.Substring(0, $filter.Length - 1)
                    $selected = 0
                }
            }
            "Tab" {

                if ($filteredItems.Count -gt 0) {

                    $item = $filteredItems[$selected]

                    if ($selectedItems.Contains($item.DownloadUrl)) {
                        $selectedItems.Remove($item.DownloadUrl) | Out-Null
                    }
                    else {
                        $selectedItems.Add($item.DownloadUrl) | Out-Null
                    }
                }
            }
            default {
                if (-not [char]::IsControl($key.KeyChar)) {
                    $filter += $key.KeyChar
                    $selected = 0
                }
            }
        }
    }
}

function Get-ReleaseBodyDownloadLinks {
    param(
        [Parameter(Mandatory)]
        $Release
    )

    $links = @()

    if ([string]::IsNullOrWhiteSpace($Release.body)) {
        return $links
    }

    $pattern = 'https://github\.com/[^\s"''<>]+/releases/download/[^\s"''<>]+'

    $matches = [regex]::Matches(
        $Release.body,
        $pattern
    )

    foreach ($match in $matches) {
        $url = $match.Value
        $url = $url.TrimEnd(')', ']', '.', ',', ';', ':')
        
        $nameAfterDownload = $url -replace '^.*?/releases/download/', ''

        $links += [PSCustomObject]@{
            Type        = "Body Link"
            Name        = $nameAfterDownload
            Size        = $null
            DownloadUrl = $url
            FileName    = Split-Path $nameAfterDownload -Leaf
            Source      = "Release description"
        }
    }

    # Remove duplicate URLs
    return @(
        $links |
            Group-Object DownloadUrl |
            ForEach-Object { $_.Group[0] }
    )
}

function Invoke-GitHubGet {
    param(
        [Parameter(Mandatory)]
        [string]$Url
    )

    return Invoke-RestMethod -Uri $Url -Headers (Get-GitHubHeaders) -Method Get
}

function Search-GitHubRepositories {
    param(
        [Parameter(Mandatory)]
        [string]$Query
    )

    $encodedQuery = [System.Uri]::EscapeDataString($Query)
    $url = "https://api.github.com/search/repositories?q=$encodedQuery&sort=stars&order=desc&per_page=50"

    $result = Invoke-GitHubGet -Url $url
    return @($result.items)
}

function Get-GitHubReleases {
    param(
        [Parameter(Mandatory)]
        [string]$FullName
    )

    $allReleases = @()
    $page = 1
    $perPage = 100

    while ($true) {
        Write-Host "Fetching releases page $page..." -ForegroundColor DarkGray

        $url = "https://api.github.com/repos/$FullName/releases?per_page=$perPage&page=$page"

        $result = @(Invoke-GitHubGet -Url $url)

        if ($result.Count -eq 0) {
            break
        }

        $allReleases += $result

        # If fewer than 100 were returned, this was the final page
        if ($result.Count -lt $perPage) {
            break
        }

        $page++
    }

    Write-Host "Fetched $($allReleases.Count) releases." -ForegroundColor Green

    return $allReleases
}

function Get-ReleaseDownloadOptions {
    param(
        [Parameter(Mandatory)]
        $Release
    )

    $options = @()

    # 1. Normal GitHub release assets
    foreach ($asset in @($Release.assets)) {
        $options += [PSCustomObject]@{
            Type        = "Asset"
            Name        = $asset.name
            Size        = $asset.size
            DownloadUrl = $asset.browser_download_url
            FileName    = $asset.name
            Source      = "GitHub assets"
        }
    }

    # 2. Extra direct links from release body/description
    $bodyLinks = Get-ReleaseBodyDownloadLinks -Release $Release

    foreach ($link in $bodyLinks) {
        # Avoid duplicate if same URL already exists in normal assets
        $alreadyExists = $options | Where-Object {
            $_.DownloadUrl -eq $link.DownloadUrl
        }

        if (-not $alreadyExists) {
            $options += $link
        }
    }

    # 3. Source code ZIP
    if ($Release.zipball_url) {
        $safeTag = ConvertTo-SafeFileName -Name $Release.tag_name

        $options += [PSCustomObject]@{
            Type        = "Source ZIP"
            Name        = "Source code ZIP"
            Size        = $null
            DownloadUrl = $Release.zipball_url
            FileName    = "$safeTag-source.zip"
            Source      = "GitHub generated source"
        }
    }

    # 4. Source code TAR.GZ
    if ($Release.tarball_url) {
        $safeTag = ConvertTo-SafeFileName -Name $Release.tag_name

        $options += [PSCustomObject]@{
            Type        = "Source TAR.GZ"
            Name        = "Source code TAR.GZ"
            Size        = $null
            DownloadUrl = $Release.tarball_url
            FileName    = "$safeTag-source.tar.gz"
            Source      = "GitHub generated source"
        }
    }

    return $options
}

function Format-Size {
    param($Bytes)

    if ($null -eq $Bytes) {
        return "unknown size"
    }

    if ($Bytes -ge 1GB) {
        return "{0:N2} GB" -f ($Bytes / 1GB)
    }

    if ($Bytes -ge 1MB) {
        return "{0:N2} MB" -f ($Bytes / 1MB)
    }

    if ($Bytes -ge 1KB) {
        return "{0:N2} KB" -f ($Bytes / 1KB)
    }

    return "$Bytes bytes"
}

function Download-ReleasePackage {
    param(
        [Parameter(Mandatory)]
        $Repo,

        [Parameter(Mandatory)]
        $Release,

        [Parameter(Mandatory)]
        $Package
    )

    $safeRepoName = ConvertTo-SafeFileName -Name $Repo.full_name.Replace("/", "__")
    $safeTag = ConvertTo-SafeFileName -Name $Release.tag_name

    $repoDownloadFolder = Join-Path $DownloadRoot $safeRepoName
    $releaseDownloadFolder = Join-Path $repoDownloadFolder $safeTag

    New-Item -ItemType Directory -Force -Path $releaseDownloadFolder | Out-Null

    $safeFileName = ConvertTo-SafeFileName -Name $Package.FileName
    $outputPath = Join-Path $releaseDownloadFolder $safeFileName

    Write-Host ""
    Write-Host "Downloading:" -ForegroundColor Cyan
    Write-Host $Package.Name
    Write-Host ""
    Write-Host "To:"
    Write-Host $outputPath -ForegroundColor Green
    Write-Host ""

    Invoke-WebRequest `
        -Uri $Package.DownloadUrl `
        -Headers (Get-GitHubHeaders) `
        -OutFile $outputPath

    Write-Host ""
    Write-Host "Download complete." -ForegroundColor Green
    Write-Host $outputPath
}

function Start-GitHubReleaseDownloader {
    while ($true) {
        Clear-Host
        Write-Host "GitHub Release Downloader" -ForegroundColor Cyan
        Write-Host ""
        Write-Host "Downloads folder:"
        Write-Host $DownloadRoot -ForegroundColor Green
        Write-Host ""
        Write-Host "Tip: Set GITHUB_TOKEN env var if you hit GitHub API rate limits."
        Write-Host ""

        $query = Read-Host "Enter repository name to search, or type q to quit"

        if ([string]::IsNullOrWhiteSpace($query)) {
            continue
        }

        if ($query.Trim().ToLower() -eq "q") {
            break
        }

        try {
            Write-Host ""
            Write-Host "Searching GitHub repositories..." -ForegroundColor Cyan
            $repos = Search-GitHubRepositories -Query $query

            if (-not $repos -or $repos.Count -eq 0) {
                Write-Host "No repositories found." -ForegroundColor Yellow
                Read-Host "Press Enter to continue"
                continue
            }

            $selectedRepo = Read-SearchableMenu `
                -Items $repos `
                -Title "Select a repository" `
                -DisplayText {
                    param($repo)
                    "$($repo.full_name) | stars: $($repo.stargazers_count) | $(Get-ShortDescription $repo.description 1 100)"
                }

            if ($null -eq $selectedRepo) {
                continue
            }

            Write-Host ""
            Write-Host "Fetching releases for $($selectedRepo.full_name)..." -ForegroundColor Cyan
            $releases = Get-GitHubReleases -FullName $selectedRepo.full_name

            if (-not $releases -or $releases.Count -eq 0) {
                Write-Host "No releases found for this repository." -ForegroundColor Yellow
                Read-Host "Press Enter to continue"
                continue
            }

            $selectedRelease = Read-SearchableMenu `
                -Items $releases `
                -Title "Select a release for $($selectedRepo.full_name)" `
                -DisplayText {
                    param($release)

                    $draft = if ($release.draft) { "draft" } else { "published" }
                    $pre = if ($release.prerelease) { "pre-release" } else { "stable" }

                    "$($release.tag_name) | $($release.name) | $pre | $draft"
                }

            if ($null -eq $selectedRelease) {
                continue
            }

            $packages = Get-ReleaseDownloadOptions -Release $selectedRelease

            if (-not $packages -or $packages.Count -eq 0) {
                Write-Host "No downloadable assets or source packages found." -ForegroundColor Yellow
                Read-Host "Press Enter to continue"
                continue
            }

            while ($true) {

                $selectedPackage = Read-SearchableMenu `
                    -Items $packages `
                    -Title "Select package to download from $($selectedRelease.tag_name)" `
                    -DisplayText {
                        param($package)

                        switch ($package.Type) {
                            "Asset" {
                                "[Asset] $($package.Name) | $(Format-Size $package.Size)"
                            }

                            "Body Link" {
                                "[From release description] $($package.Name)"
                            }

                            "Source ZIP" {
                                "[Source] $($package.Name)"
                            }

                            "Source TAR.GZ" {
                                "[Source] $($package.Name)"
                            }

                            default {
                                "[$($package.Type)] $($package.Name)"
                            }
                        }
                    }

                if ($null -eq $selectedPackage) {
                    break      # Esc returns to release selection
                }

                foreach ($package in $selectedPackage) {

                    Download-ReleasePackage `
                        -Repo $selectedRepo `
                        -Release $selectedRelease `
                        -Package $package
                }

                Write-Host ""
                Write-Host "Download complete." -ForegroundColor Green
                Write-Host "Select another package or press Esc to go back."
                Read-Host "Press Enter"
            }
        }
        catch {
            Write-Host ""
            Write-Host "Something went wrong:" -ForegroundColor Red
            Write-Host $_.Exception.Message -ForegroundColor Red
            Write-Host ""
            Read-Host "Press Enter to continue"
        }
    }
}

Start-GitHubReleaseDownloader
